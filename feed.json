---
layout: null
permalink: /feed.json
---

{% assign markdown_articles = site.pages | where_exp: "page", "page.path contains 'articles/' and page.name == 'index.md'" %}
{% assign html_articles = site.pages | where_exp: "page", "page.path contains 'articles/' and page.name == 'index.html'" %}
{% assign articles = markdown_articles | concat: html_articles | sort: "date" | reverse %}
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ site.title | default: "Working-Draft.org" | jsonify }},
  "home_page_url": {{ site.url | jsonify }},
  "feed_url": {{ "/feed.json" | absolute_url | jsonify }},
  "description": {{ site.description | jsonify }},
  "items": [
    {% for article in articles %}
      {
        "id": {{ article.url | absolute_url | jsonify }},
        "url": {{ article.url | absolute_url | jsonify }},
        "title": {{ article.title | jsonify }},
        "summary": {{ article.summary | default: article.description | default: "" | jsonify }},
        "content_text": {{ article.content | strip_html | strip_newlines | truncate: 500 | jsonify }},
        "date_published": {{ article.date | date_to_xmlschema | jsonify }},
        "tags": {{ article.tags | default: empty | jsonify }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
